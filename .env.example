# Optional automatic AI interpretation during Kundali generation
AI_API_KEY=
OPENAI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4.1-mini
AI_PROVIDER=openai-compatible

# Optional administrative endpoint. Leave blank to disable web-triggered corpus sync.
# Use a long random value and configure it only in the server environment or a private .env file.
WORLD_EVENTS_SYNC_TOKEN=
